{
  "name": "recast-windows",
  "version": "1.0.0",
  "description": "Recast universal on-device file converter for Windows 11",
  "author": "Luke McLaughlin",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "prepare:images": "node scripts/prepare-image-engine.mjs",
    "prepare:documents": "node scripts/prepare-document-engines.mjs",
    "build": "node scripts/prepare-image-engine.mjs && node scripts/prepare-document-engines.mjs && node scripts/make-icon.mjs && tsc && vite build && tsc -p tsconfig.electron.json",
    "package:win": "pnpm run build && electron-builder --win dir --x64 --publish never && powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-installer.ps1 && powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/make-portable.ps1"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@napi-rs/canvas": "0.1.80",
    "@resvg/resvg-js": "2.6.2",
    "adm-zip": "0.5.16",
    "archiver": "7.0.1",
    "bmp-js": "0.1.0",
    "docx": "9.5.1",
    "fast-xml-parser": "5.10.0",
    "ffmpeg-static": "5.2.0",
    "html-to-text": "9.0.5",
    "js-yaml": "5.2.1",
    "lucide-react": "0.468.0",
    "mammoth": "1.12.0",
    "marked": "15.0.12",
    "papaparse": "5.5.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "plist": "3.1.0",
    "png-to-ico": "3.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.34.5",
    "turndown": "7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/adm-zip": "0.5.7",
    "@types/archiver": "6.0.3",
    "@types/bmp-js": "^0.1.2",
    "@types/html-to-text": "^9.0.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.2",
    "@types/papaparse": "5.3.16",
    "@types/plist": "^3.0.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/turndown": "5.0.5",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "rcedit": "5.0.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.61.1",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.lukemclaughlin.recast",
    "productName": "Recast",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "vendor/imagemagick/**/*",
      "vendor/libreoffice/**/*",
      "vendor/pandoc/**/*",
      "THIRD-PARTY-ENGINES.md",
      "README.md",
      "native/image-policy/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/ffmpeg-static/**/*",
      "**/@napi-rs/**/*",
      "**/@resvg/**/*",
      "**/sharp/**/*",
      "vendor/**/*",
      "native/**/*"
    ],
    "afterPack": "build/afterPack.cjs",
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
